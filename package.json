    "test:python": "python -m unittest discover -s tests-python -v"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "ajv": "8.20.0",
    "three": "0.180.0",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
