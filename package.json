{
  "name": "vfxai-local",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local Python-trainable VFX plan research project with a Three.js browser preview",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
